AWS_REGION=us-east-1
TIMELINE_TABLE=pilotlight-timeline
INCIDENTS_TABLE=pilotlight-incidents
FAIL_MODE_PARAM=/pilotlight/checkout/fail_mode
CHECKOUT_LOG_GROUP=/aws/lambda/pilotlight-checkout
ALARM_NAME=pilotlight-checkout-5xx

# Box
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_RUNBOOKS_FOLDER_ID=
BOX_INCIDENTS_FOLDER_ID=
BOX_REVIEWER_LOGIN=you@example.com

# Bedrock
SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
TEXT_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Telephony (AWS Connect or Twilio)
VOICE_SERVER_URL=https://<ngrok-id>.ngrok.app
ONCALL_PHONE=+1206XXXXXXX

# GitHub (for auto-fix pipeline)
GITHUB_REPO=harikasatti06-techie/Pilot-Light
GITHUB_TOKEN=

# CodeBuild
CODEBUILD_PROJECT=pilotlight-agent
CONFIDENCE_THRESHOLD=0.6

# Auto-fix dispatcher
DISPATCHER_FUNCTION_NAME=pilotlight-dispatcher

# DynamoDB (auto-fix)
TASKS_TABLE=pilotlight-tasks
